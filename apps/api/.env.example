PORT=5000
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecovision"

# Better Auth
BETTER_AUTH_SECRET="change-this-in-production-super-secret-key-32chars"
BETTER_AUTH_URL="http://localhost:5000"

# Google OAuth (The ONLY provider)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Frontend Origin for CORS and cookies
FRONTEND_URL="http://localhost:3000"

# FastAPI AI Microservice URL
AI_SERVICE_URL="http://localhost:8000"

# Supabase Storage (Optional for local dev - falls back to LocalFileStorageService if omitted)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="ecovision-images"
